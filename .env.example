# TUESDAY server configuration — copy to .env and fill values.
# NEVER commit .env or real keys.

# --- App ---
TUESDAY_ENV=development
TUESDAY_HOST=0.0.0.0
TUESDAY_PORT=8000
TUESDAY_LOG_LEVEL=INFO
TUESDAY_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
TUESDAY_DATA_DIR=./data
TUESDAY_DATABASE_URL=sqlite+aiosqlite:///./data/tuesday.db
TUESDAY_SECRET_KEY=change-me-to-a-long-random-string
TUESDAY_ACCESS_TOKEN=change-me-to-a-separate-long-random-token
TUESDAY_SESSION_TTL_SEC=604800
TUESDAY_RATE_LIMIT_PER_MINUTE=120
TUESDAY_MAX_REQUEST_BYTES=12582912
TUESDAY_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Models (NVIDIA OpenAI-compatible) ---
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL_PRIMARY=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_MODEL_FAST=nvidia/llama-3.1-nemotron-70b-instruct
NVIDIA_MODEL_FALLBACK=
# When no key: mock streaming responses (development only)
TUESDAY_ALLOW_MOCK_MODEL=true

# --- Sandbox / workspace ---
# local | e2b | cua
SANDBOX_PROVIDER=local
SANDBOX_IDLE_TIMEOUT_SEC=900
SANDBOX_MAX_COMMAND_TIMEOUT_SEC=120
SANDBOX_MAX_OUTPUT_BYTES=1048576
SANDBOX_MAX_FILE_BYTES=10485760
SANDBOX_MAX_CONCURRENT=5
WORKSPACE_ROOT_IN_SANDBOX=/workspace

# E2B (cloud Firecracker) — server-side only
E2B_API_KEY=
E2B_TEMPLATE_ID=
E2B_TIMEOUT_SEC=3600

# Cua (optional / early access)
CUA_API_KEY=
CUA_API_URL=

# --- Voice ---
# STT: whisper | nemotron_asr | none
STT_PROVIDER=none
STT_API_URL=
STT_MODEL=openai/whisper-large-v3
STT_MAX_AUDIO_BYTES=15728640
# TTS: fish | none
TTS_PROVIDER=none
FISH_AUDIO_API_URL=https://api.fish.audio/v1/tts
FISH_AUDIO_API_KEY=
FISH_AUDIO_VOICE_ID=
FISH_AUDIO_MODEL=s2.1-pro-free

# --- Memory ---
MEMORY_ENABLED=true
MEMORY_EMBEDDINGS_ENABLED=false

# --- Safety ---
REQUIRE_APPROVAL_FOR_NETWORK=true
REQUIRE_APPROVAL_FOR_DESTRUCTIVE=true
REQUIRE_APPROVAL_FOR_SHELL=true
REQUIRE_APPROVAL_FOR_GUI=true
BLOCK_INTERNAL_NETWORK=true
PROACTIVE_NOTIFICATIONS_ENABLED=false

# --- Object storage (optional) ---
# local | s3
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./data/storage
